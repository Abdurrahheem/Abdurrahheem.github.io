---
layout: default
---
<!-- _layouts/project_gng.liquid: "paper and dots" project page for Guess & Guide.
     One variable, --p, runs the page: it sets how far the dots have grown, in the title and in every picture. -->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  /* The page is a sheet of paper in both site themes, so the navbar and footer follow. */
  :root, html[data-theme="light"], html[data-theme="dark"] {
    --global-bg-color: #F3EFE6;
    --global-text-color: #14161B;
    --global-text-color-light: #62666F;
    --global-theme-color: #1B3FD8;
    --global-hover-color: #1B3FD8;
    --global-hover-text-color: #F3EFE6;
    --global-divider-color: #CFC8B8;
    --global-card-bg-color: #FAF8F2;
    --global-code-bg-color: #E9E4D7;
    --global-footer-bg-color: #F3EFE6;
    --global-footer-text-color: #62666F;
    --global-footer-link-color: #14161B;
    --gg-paper: #F3EFE6; --gg-paper-2: #E9E4D7; --gg-ink: #14161B; --gg-soft: #3B3F48; --gg-dim: #62666F;
    --gg-rule: #CFC8B8; --gg-blue: #1B3FD8; --gg-red: #C2372B;
  }
  body { overflow-x: clip; background-image: radial-gradient(circle, #DCD5C5 1px, rgba(220,213,197,0) 1.5px); background-size: 24px 24px; }

  .gg { --p: .5; font-family: "Instrument Sans", "Avenir Next", "Helvetica Neue", sans-serif; color: var(--gg-ink);
    font-size: 1.05rem; line-height: 1.6; }
  .gg *, .gg *::before, .gg *::after { box-sizing: border-box; }
  .gg a { color: var(--gg-blue); }
  .gg i.v { font-family: "Fraunces", Georgia, serif; font-style: italic; font-size: 1.06em; }
  .gg i.gg-a { font-family: "Fraunces", Georgia, serif; font-style: italic; }
  .gg-lab { font-size: .72rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .gg-serif { font-family: "Fraunces", Georgia, serif; }
  .gg-bleed { width: 100vw; margin-left: calc(50% - 50vw); }
  .gg-in { width: min(1180px, calc(100vw - 2rem)); margin: 0 auto; }
  .gg-wide { width: min(1180px, calc(100vw - 2rem)); margin-left: calc(50% - min(590px, 50vw - 1rem)); }

  /* ---------- hero ---------- */
  .gg-hero { margin-top: -1.2rem; }
  .gg-venue { display: flex; flex-wrap: wrap; gap: .3rem 1.4rem; color: var(--gg-dim); margin: 0 0 1.1rem; }
  .gg-venue span::before { content: ""; display: inline-block; width: .5em; height: .5em; border-radius: 50%;
    background: var(--gg-blue); margin-right: .6em; vertical-align: .08em; }
  .gg-venue span + span::before { background: none; box-shadow: inset 0 0 0 1.5px var(--gg-dim); }
  .gg-title { margin: 0; font-family: "Fraunces", Georgia, serif; font-weight: 900; color: var(--gg-ink);
    font-size: min(21vw, 9rem); line-height: .88; letter-spacing: -.035em; }
  .gg-title .gg-br { display: block; }
  .gg-guess { position: relative; display: inline-block; font-style: italic; padding-right: .07em; margin-right: -.07em; }
  /* "Guess" is a pencil outline filled with dots; the dots grow as the ruler moves toward the restoration. */
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .gg-guess { --tr: calc(.022em + var(--p) * .032em); color: transparent;
      background-image: radial-gradient(circle at 50% 50%, var(--gg-ink) var(--tr), rgba(20,22,27,0) calc(var(--tr) + .6px));
      background-size: .075em .075em; -webkit-background-clip: text; background-clip: text; }
    .gg-guess::before { content: attr(data-t); position: absolute; left: 0; top: 0; color: rgba(20,22,27,.16); z-index: -1; }
  }
  .gg-amp { font-style: italic; font-weight: 400; color: var(--gg-blue); letter-spacing: 0; margin: 0 .04em 0 .02em; }
  .gg-sub { display: block; font-weight: 500; font-size: clamp(1.35rem, 3.1vw, 2.2rem); line-height: 1.15; letter-spacing: -.01em;
    margin-top: 1.1rem; }
  .gg-meta { display: grid; gap: 1.4rem; margin-top: .9rem; }
  .gg-hand { font-family: "Caveat", "Bradley Hand", cursive; font-weight: 600; color: var(--gg-blue); font-size: 1.55rem;
    line-height: 1.15; margin: 0; transform: rotate(-1.5deg); transform-origin: 0 50%; max-width: 21rem; }
  .gg-hand span { color: var(--gg-dim); }
  .gg-authors { font-size: 1rem; line-height: 1.75; margin: 0; }
  .gg-authors span { white-space: nowrap; }
  .gg-authors span:not(:last-child)::after { content: ","; }
  .gg-authors sup, .gg-aff sup { color: var(--gg-blue); font-weight: 600; }
  .gg-aff { font-size: .9rem; color: var(--gg-dim); margin: .45rem 0 0; line-height: 1.6; }
  .gg-aff span { display: block; }
  .gg-links { display: flex; flex-wrap: wrap; gap: .6rem; margin: 1.2rem 0 0; }
  .gg-links a { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1.15rem; border: 1.5px solid var(--gg-ink);
    color: var(--gg-ink); text-decoration: none; box-shadow: 3px 3px 0 var(--gg-ink); background: var(--gg-paper);
    transition: transform .12s, box-shadow .12s; }
  .gg-links a.fill { background: var(--gg-ink); color: var(--gg-paper); box-shadow: 3px 3px 0 var(--gg-blue); }
  .gg-links a:hover { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--gg-ink); text-decoration: none; }
  .gg-links a.fill:hover { box-shadow: 1px 1px 0 var(--gg-blue); }
  .gg a:focus-visible, .gg button:focus-visible { outline: 2.5px solid var(--gg-blue); outline-offset: 3px; }

  /* ---------- section furniture ---------- */
  .gg-sec { margin-top: clamp(3rem, 7vw, 5rem); }
  .gg-kick { display: flex; align-items: center; gap: .9rem; margin: 0 0 1.3rem; color: var(--gg-ink); font-family: inherit; }
  .gg-kick small { font: inherit; color: var(--gg-dim); }
  /* a sparse row of dots says where we are on the page */
  .gg-pos { display: inline-flex; gap: .32rem; }
  .gg-pos i { width: .5rem; height: .5rem; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--gg-dim); }
  .gg-pos i.on { background: var(--gg-blue); box-shadow: none; }
  .gg-lede { font-family: "Fraunces", Georgia, serif; font-weight: 400; font-size: clamp(1.4rem, 2.9vw, 1.95rem); line-height: 1.28;
    letter-spacing: -.01em; margin: 0 0 1.1rem; max-width: 46rem; }
  .gg-lede b { font-weight: 600; color: var(--gg-blue); }
  .gg p.gg-body { color: var(--gg-soft); max-width: 44rem; margin: 0 0 1rem; }
  .gg-note { font-size: .86rem; color: var(--gg-dim); margin: 1.1rem 0 0; max-width: 46rem; line-height: 1.5; }

  /* ---------- restorations: one ruler, four pictures ---------- */
  .gg-band { background: var(--gg-paper-2); border-top: 1.5px solid var(--gg-ink); border-bottom: 1.5px solid var(--gg-ink);
    padding: clamp(1.5rem, 3.5vw, 2.4rem) 0 clamp(1.7rem, 4vw, 2.6rem); margin-top: clamp(2rem, 5vw, 3.2rem); }
  .gg-band .gg-kick { margin-bottom: .5rem; }
  .gg-ruler, .gg-if-js { display: none; }
  .gg-js .gg-if-js { display: block; } .gg-js .gg-no-js { display: none; }
  .gg-js .gg-ruler { display: block; margin: 0 0 1.1rem; }
  .gg-ends { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; }
  .gg-ends button { font: inherit; font-size: .72rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase;
    background: none; border: 0; padding: 0; min-height: 2.75rem; color: var(--gg-dim); cursor: pointer; text-align: left; }
  .gg-ends button + button { text-align: right; }
  .gg-ends button i.v { text-transform: none; letter-spacing: 0; font-size: 1.25rem; font-weight: 500; margin: 0 .35em; color: var(--gg-ink); }
  .gg-ends button[aria-pressed="true"] { color: var(--gg-blue); }
  .gg-ends button:hover { color: var(--gg-ink); }
  .gg-ends button span, .gg-aff span, .gg-s-axis span { color: inherit; }
  .gg-track { position: relative; height: 3rem; margin: 0 1.375rem; touch-action: pan-y; cursor: ew-resize;
    user-select: none; -webkit-user-select: none; }
  /* ruler ticks, a base line, and the inked part of it */
  .gg-track::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: .7rem; margin-top: -.35rem;
    background: repeating-linear-gradient(to right, var(--gg-dim) 0, var(--gg-dim) 1px, rgba(0,0,0,0) 1px, rgba(0,0,0,0) calc(100% / 60));
    border-right: 1px solid var(--gg-dim); opacity: .55; }
  .gg-track::after { content: ""; position: absolute; left: 0; top: 50%; height: 3px; margin-top: -1.5px; border-radius: 2px;
    width: calc(var(--p) * 100%); background: var(--gg-blue); }
  .gg-stop { position: absolute; top: 50%; width: .75rem; height: .75rem; margin: -.375rem 0 0 -.375rem; border-radius: 50%;
    background: var(--gg-paper-2); border: 1.5px solid var(--gg-ink); z-index: 1; pointer-events: none; }
  .gg-stop.on { background: var(--gg-blue); border-color: var(--gg-blue); }
  .gg-handle { position: absolute; z-index: 2; top: 50%; left: calc(var(--p) * 100%); width: 2.75rem; height: 2.75rem;
    margin: -1.375rem 0 0 -1.375rem; padding: 0; border: 0; background: none; cursor: ew-resize; touch-action: pan-y;
    display: grid; place-items: center; }
  .gg-handle::before { content: ""; width: 1.9rem; height: 1.9rem; border-radius: 50%; background: var(--gg-paper);
    border: 3px solid var(--gg-blue); box-shadow: 2px 2px 0 var(--gg-ink); }
  .gg-handle::after { content: ""; position: absolute; width: .5rem; height: .5rem; border-radius: 50%; background: var(--gg-blue); }
  .gg-handle.hint::before { animation: gg-hint 1.8s ease-in-out infinite; }
  @keyframes gg-hint { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.16); } }

  .gg-plates { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(.75rem, 2vw, 1.5rem); }
  .gg-plate { margin: 0; min-width: 0; }
  .gg-pair { position: relative; display: grid; grid-template-columns: 1fr 1fr; background: var(--gg-paper);
    border: 1.5px solid var(--gg-ink); box-shadow: 4px 4px 0 var(--gg-ink); overflow: hidden; }
  .gg-pair img { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; }
  .gg-js .gg-pair { display: block; aspect-ratio: 1 / 1; touch-action: pan-y; cursor: pointer;
    user-select: none; -webkit-user-select: none; }
  /* The source PNGs carry a thin white edge (2px on top, 3px on the left of the restorations): both images are
     cropped by the same 4px of 360 on every side so the frame hides it. Nothing is rescaled differently. */
  .gg-js .gg-pair img { position: absolute; left: -1.14%; top: -1.14%; width: 102.28%; height: 102.28%; max-width: none;
    pointer-events: none; -webkit-user-drag: none; }
  /* The restoration shows through two offset lattices of dots. Each pixel is one image or the other, untouched. */
  .gg-js .gg-res { --r: calc(var(--p) * 108%);
    -webkit-mask-image: radial-gradient(circle closest-side, #000 var(--r), rgba(0,0,0,0) calc(var(--r) + 1px)),
                        radial-gradient(circle closest-side, #000 var(--r), rgba(0,0,0,0) calc(var(--r) + 1px));
            mask-image: radial-gradient(circle closest-side, #000 var(--r), rgba(0,0,0,0) calc(var(--r) + 1px)),
                        radial-gradient(circle closest-side, #000 var(--r), rgba(0,0,0,0) calc(var(--r) + 1px));
    -webkit-mask-size: 12.5% 12.5%; mask-size: 12.5% 12.5%;
    -webkit-mask-position: 0 0, calc(100% / 14) calc(100% / 14); mask-position: 0 0, calc(100% / 14) calc(100% / 14);
    -webkit-mask-repeat: repeat; mask-repeat: repeat; }
  .gg-js[data-state="obs"] .gg-res { visibility: hidden; }
  .gg-js[data-state="res"] .gg-res { -webkit-mask-image: none; mask-image: none; }
  .gg-plate figcaption { display: flex; justify-content: space-between; align-items: baseline; gap: .6rem; padding-top: .85rem; }
  .gg-plate figcaption b { font-family: "Fraunces", Georgia, serif; font-weight: 600; font-size: clamp(1rem, 1.9vw, 1.3rem); line-height: 1.15; }
  .gg-plate figcaption b small { font-family: "Instrument Sans", sans-serif; font-size: .68rem; font-weight: 600; letter-spacing: .1em;
    color: var(--gg-blue); margin-right: .5em; vertical-align: .15em; }
  .gg-state { font-size: .62rem; color: var(--gg-dim); text-align: right; white-space: nowrap; }

  /* ---------- contributions ---------- */
  .gg-three { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.6rem 2.4rem; margin-top: 2.2rem; }
  .gg-three div { border-top: 1.5px solid var(--gg-ink); padding-top: .9rem; }
  .gg-three h3 { font-family: "Fraunces", Georgia, serif; font-weight: 600; font-size: 1.22rem; line-height: 1.2; margin: 0 0 .5rem; color: var(--gg-ink); }
  .gg-three p { margin: 0; color: var(--gg-soft); font-size: .98rem; }

  /* ---------- method: the schedule ---------- */
  .gg-sched { --L: 8.125rem; position: relative; margin: 2.2rem 0 .4rem; }
  .gg-s-row { display: flex; align-items: flex-end; height: calc(var(--L) * .846 + 1.2rem); }
  .gg-s-skip { flex: 1.1 1 0; min-width: 2.6rem; height: 100%; position: relative; border-bottom: 2px dashed #A9A395; }
  .gg-s-loop { flex: 0 0 var(--L); height: 100%; position: relative; }
  .gg-s-loop::before, .gg-s-loop::after { content: ""; position: absolute; bottom: 0; width: 50%; }
  .gg-s-loop::before { left: 0; border-bottom: 2px dashed #A9A395; }
  .gg-s-loop::after { right: 0; border-bottom: 2px solid var(--gg-blue); }
  .gg-s-loop svg { position: absolute; left: 0; bottom: -2px; width: var(--L); height: calc(var(--L) * .846); overflow: visible; }
  .gg-s-run { flex: 3.2 1 0; height: 100%; position: relative; border-bottom: 2px solid var(--gg-blue); }
  .gg-s-run i { position: absolute; bottom: -.44rem; width: .75rem; height: .75rem; margin-left: -.375rem; border-radius: 50%;
    background: var(--gg-blue); border: 2px solid var(--gg-blue); }
  .gg-s-run i.end { width: 1rem; height: 1rem; margin-left: -.5rem; bottom: -.56rem; background: var(--gg-ink); border-color: var(--gg-ink); }
  .gg-sched.live .gg-s-run i { background: var(--gg-paper); }
  .gg-sched.live .gg-s-run i.on { background: var(--gg-blue); }
  .gg-sched.live .gg-s-run i.end { background: var(--gg-paper); }
  .gg-sched.live .gg-s-run i.end.on { background: var(--gg-ink); }
  .gg-s-tag { position: absolute; left: 0; bottom: .7rem; font-size: .68rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
    line-height: 1.3; color: var(--gg-dim); }
  .gg-s-tag b { display: block; font-family: "Fraunces", Georgia, serif; font-weight: 700; font-style: italic; font-size: 1.5rem;
    letter-spacing: -.01em; text-transform: none; color: var(--gg-ink); line-height: 1.1; }
  .gg-s-loop .gg-s-tag { left: 0; right: 0; top: 0; bottom: auto; text-align: center; }
  .gg-s-run .gg-s-tag { left: 1.2rem; bottom: 2.1rem; }
  .gg-s-run .gg-s-tag b { color: var(--gg-blue); font-style: normal; }
  .gg-s-axis { display: flex; padding-top: .8rem; font-size: .8rem; color: var(--gg-dim); line-height: 1.25; }
  .gg-s-axis span:nth-child(1) { flex: 1.1 1 0; min-width: 2.6rem; }
  .gg-s-axis span:nth-child(2) { flex: 0 0 var(--L); text-align: center; }
  .gg-s-axis span:nth-child(3) { flex: 3.2 1 0; text-align: right; }
  .gg-s-axis i.v { display: block; font-size: 1.3rem; color: var(--gg-ink); }
  .gg-s-dot { position: absolute; left: 0; top: 0; width: 1.1rem; height: 1.1rem; margin: -.55rem 0 0 -.55rem; border-radius: 50%;
    background: var(--gg-red); box-shadow: 0 0 0 3px var(--gg-paper); display: none; opacity: 0; pointer-events: none; will-change: transform; }
  .gg-sched.live .gg-s-dot { display: block; }

  .gg-phases { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 2rem 3.2rem; margin-top: 2.4rem; }
  .gg-phase h3 { font-family: "Fraunces", Georgia, serif; font-weight: 700; font-size: 1.6rem; line-height: 1.1; margin: .3rem 0 .7rem; color: var(--gg-ink); }
  .gg-phase.one h3 em { font-style: italic; } .gg-phase.two h3 em { font-style: normal; color: var(--gg-blue); }
  .gg-phase > span { color: var(--gg-dim); }
  .gg-phase p { margin: 0 0 .8rem; color: var(--gg-soft); }
  .gg-phase ol { list-style: none; margin: 0 0 1rem; padding: 0; counter-reset: s; }
  .gg-phase li { counter-increment: s; position: relative; padding: .55rem .6rem .55rem 2.5rem; border-top: 1px solid var(--gg-rule);
    transition: background .25s; }
  .gg-phase li:last-child { border-bottom: 1px solid var(--gg-rule); }
  .gg-phase li::before { content: counter(s); position: absolute; left: .45rem; top: .58rem; width: 1.45rem; height: 1.45rem; border-radius: 50%;
    display: grid; place-items: center; font-size: .78rem; font-weight: 600; border: 1.5px solid var(--gg-ink); color: var(--gg-ink);
    transition: background .25s, color .25s, border-color .25s; }
  .gg-phase.two li::before { content: ""; width: .8rem; height: .8rem; left: .78rem; top: .95rem; border-color: var(--gg-blue); }
  .gg-phase li b { font-weight: 600; }
  .gg-phase li.on { background: rgba(27,63,216,.08); }
  .gg-phase.one li.on::before { background: var(--gg-ink); color: var(--gg-paper); }
  .gg-phase.two li.on::before { background: var(--gg-blue); }
  .gg-fig { margin-top: 2.6rem; margin-bottom: 0; margin-right: 0; }
  .gg-fig a { display: block; }
  .gg-fig img { display: block; width: 100%; height: auto; mix-blend-mode: multiply; }
  .gg-fig figcaption { font-family: "Caveat", "Bradley Hand", cursive; font-weight: 600; font-size: 1.4rem; color: var(--gg-dim); text-align: center; }

  /* ---------- results ---------- */
  .gg-tablewrap { margin-top: 1.6rem; }
  .gg table.gg-table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; margin: 0; color: var(--gg-ink); }
  .gg-table caption { caption-side: top; text-align: left; padding: 0 0 .7rem; color: var(--gg-dim); font-size: .72rem; font-weight: 600;
    letter-spacing: .14em; text-transform: uppercase; }
  .gg-table th, .gg-table td { border: 0; background: none; text-align: left; padding: .7rem .5rem; }
  .gg-table thead th { font-size: .72rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--gg-dim);
    border-bottom: 1.5px solid var(--gg-ink); padding-bottom: .55rem; }
  .gg-table tbody th { font-weight: 500; color: var(--gg-soft); }
  .gg-table tbody tr > * { border-bottom: 1px solid var(--gg-rule); }
  .gg-table td { white-space: nowrap; font-size: 1.08rem; color: var(--gg-soft); }
  .gg-table td small { font-size: .82rem; color: var(--gg-dim); margin-left: .35rem; }
  .gg-table .us { background: rgba(27,63,216,.07); }
  .gg-table thead th.us { color: var(--gg-blue); }
  .gg-table td.best strong { font-weight: 600; color: var(--gg-ink); }
  .gg-table td.best strong::before { content: ""; display: inline-block; width: .5rem; height: .5rem; border-radius: 50%; background: var(--gg-blue);
    margin-right: .4rem; vertical-align: .12em; }
  .gg-table td:not(.best) strong { font-weight: 400; padding-left: .9rem; color: var(--gg-soft); }

  .gg-blue { --global-text-color: #F3EFE6; background: var(--gg-blue); color: #F3EFE6; padding: clamp(2rem, 5vw, 3.4rem) 0; margin-top: clamp(2.5rem, 6vw, 4rem); }
  .gg-blue .gg-kick { color: #F3EFE6; } .gg-blue .gg-kick small { color: rgba(243,239,230,.78); }
  .gg-blue .gg-pos i { box-shadow: inset 0 0 0 1.5px rgba(243,239,230,.8); } .gg-blue .gg-pos i.on { background: #F3EFE6; box-shadow: none; }
  .gg-cost { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.2rem 3rem; }
  .gg-bars h3 { font-family: "Fraunces", Georgia, serif; font-weight: 600; font-size: 1.3rem; line-height: 1.15; color: #F3EFE6; margin: 0 0 .2rem; }
  .gg-bars > span { display: block; color: rgba(243,239,230,.8); margin-bottom: 1rem; }
  .gg-bar { display: grid; grid-template-columns: 5.2rem minmax(0, 1fr) auto; align-items: center; gap: .7rem; padding: .5rem 0;
    border-top: 1px solid rgba(243,239,230,.28); font-variant-numeric: tabular-nums; }
  .gg-bar .n { font-size: .95rem; } .gg-bar .v { font-size: 1.05rem; min-width: 4.6rem; text-align: right; }
  .gg-bar .b { display: block; height: .6rem; }
  .gg-bar .b i { display: block; height: 100%; min-width: .6rem; border-radius: .3rem; background: rgba(243,239,230,.5);
    width: calc(var(--v) / var(--m) * 100%); }
  .gg-bar.us .n, .gg-bar.us .v { font-weight: 600; } .gg-bar.us .b i { background: #F3EFE6; }
  .gg-takes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.4rem 3rem; margin-top: 2.4rem; }
  .gg-takes p { margin: 0; font-family: "Fraunces", Georgia, serif; font-size: clamp(1.15rem, 2.1vw, 1.4rem); line-height: 1.32; }
  .gg-takes b { display: block; font-family: "Instrument Sans", sans-serif; font-size: .72rem; font-weight: 600; letter-spacing: .14em;
    text-transform: uppercase; margin-bottom: .5rem; color: rgba(243,239,230,.8); }

  /* ---------- limits, citation ---------- */
  .gg-limit { border-left: 3px solid var(--gg-red); padding: .1rem 0 .1rem 1.2rem; max-width: 44rem; }
  .gg-limit p { margin: 0; color: var(--gg-soft); }
  .gg-bib { position: relative; border: 1.5px solid var(--gg-ink); background: #FAF8F2; box-shadow: 4px 4px 0 var(--gg-ink); }
  .gg-bib pre { margin: 0; padding: 1.2rem 1.3rem; overflow-x: auto; background: none; border: 0; color: var(--gg-ink);
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: .8rem; line-height: 1.6; }
  .gg-bib button { position: absolute; top: .6rem; right: .6rem; font: inherit; font-size: .68rem; font-weight: 600; letter-spacing: .14em;
    text-transform: uppercase; padding: .45rem .8rem; cursor: pointer; border: 1.5px solid var(--gg-ink); background: var(--gg-paper); color: var(--gg-ink); }
  .gg-bib button:hover { background: var(--gg-ink); color: var(--gg-paper); }
  .gg-end { color: var(--gg-dim); margin: 3rem 0 1rem; }

  @media (min-width: 760px) {
    .gg-title { font-size: min(11.4vw, 10.2rem); }
    .gg-sched { --L: 11.5rem; }
    .gg-title .gg-br { display: none; }
    .gg-meta { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 3rem; align-items: start; margin-top: 1.1rem; }
    .gg-hand { font-size: 1.9rem; max-width: 24rem; margin-top: .3rem; }
  }
  @media (max-width: 759px) {
    .gg-plates { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.3rem; }
    .gg-three, .gg-phases, .gg-cost, .gg-takes { grid-template-columns: minmax(0, 1fr); }
    .gg-s-tag { font-size: .6rem; letter-spacing: .08em; }
    .gg-s-tag b { font-size: 1.25rem; }
    .gg-s-run .gg-s-tag { left: .7rem; }
    .gg-state, .gg-xl { display: none; }
    .gg-table th, .gg-table td { padding: .6rem .3rem; }
    .gg-table td { font-size: 1rem; }
    .gg-table td small { display: block; margin: 0; }
    .gg-table td:not(.best) strong, .gg-table td:not(.best) small { padding-left: 0; }
    .gg-table td.best strong::before { margin-right: .25rem; }
    .gg-bib pre { padding-top: 3rem; font-size: .74rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gg-handle.hint::before { animation: none; }
    .gg-links a, .gg-phase li, .gg-phase li::before { transition: none; }
  }
</style>

<div class="post gg">
  {{ content }}
</div>

<script>
  (function () {
    var root = document.querySelector(".gg");
    if (!root) return;
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var raf = window.requestAnimationFrame || function (f) { return setTimeout(function () { f(Date.now()); }, 16); };
    function clamp(v) { return Math.min(1, Math.max(0, v)); }
    function ease(u) { return u < 0.5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2; }

    /* ---------- the ruler: one value, p, from observation (0) to restoration (1) ---------- */
    var track = root.querySelector(".gg-track"), handle = root.querySelector(".gg-handle");
    if (track && handle) {
      var stops = Array.prototype.slice.call(root.querySelectorAll(".gg-stop"));
      var ends = Array.prototype.slice.call(root.querySelectorAll(".gg-ends button"));
      var states = Array.prototype.slice.call(root.querySelectorAll(".gg-state"));
      var p = 0.5, anim = 0, touched = false;

      function apply(v) {
        p = clamp(v);
        var state = p <= 0.004 ? "obs" : p >= 0.996 ? "res" : "mix";
        root.style.setProperty("--p", p.toFixed(4));
        root.setAttribute("data-state", state);
        var pct = Math.round(p * 100);
        handle.setAttribute("aria-valuenow", pct);
        handle.setAttribute("aria-valuetext", state === "obs" ? "Degraded observation only" :
          state === "res" ? "Restoration only" : pct + " percent toward the restoration");
        stops.forEach(function (s) { s.classList.toggle("on", parseFloat(s.getAttribute("data-at")) <= p + 0.001); });
        if (ends.length === 2) {
          ends[0].setAttribute("aria-pressed", state === "obs" ? "true" : "false");
          ends[1].setAttribute("aria-pressed", state === "res" ? "true" : "false");
        }
        var word = state === "obs" ? "Observation" : state === "res" ? "Restoration" : "Both";
        states.forEach(function (n) { if (n.textContent !== word) n.textContent = word; });
      }
      function glide(target, ms) {
        anim += 1;
        if (reduce) { apply(target); return; }
        var id = anim, from = p, t0 = null;
        raf(function step(now) {
          if (id !== anim) return;
          if (t0 === null) t0 = now;
          var u = Math.min(1, (now - t0) / ms);
          apply(from + (target - from) * ease(u));
          if (u < 1) raf(step);
        });
      }
      function touch() { touched = true; anim += 1; handle.classList.remove("hint"); }

      // Drag along the ruler: the handle follows the pointer.
      var dragging = false;
      function follow(e) { var r = track.getBoundingClientRect(); apply((e.clientX - r.left) / Math.max(1, r.width)); }
      track.addEventListener("pointerdown", function (e) {
        dragging = true; touch();
        try { track.setPointerCapture(e.pointerId); } catch (err) {}
        follow(e);
      });
      track.addEventListener("pointermove", function (e) { if (dragging) follow(e); });
      ["pointerup", "pointercancel", "lostpointercapture"].forEach(function (name) {
        track.addEventListener(name, function () { dragging = false; });
      });
      handle.addEventListener("keydown", function (e) {
        var k = e.key, v = null;
        if (k === "ArrowLeft" || k === "ArrowDown") v = p - 1 / 12;
        else if (k === "ArrowRight" || k === "ArrowUp") v = p + 1 / 12;
        else if (k === "PageDown") v = p - 1 / 3;
        else if (k === "PageUp") v = p + 1 / 3;
        else if (k === "Home") v = 0;
        else if (k === "End") v = 1;
        if (v !== null) { touch(); apply(Math.round(clamp(v) * 12) / 12); e.preventDefault(); }
      });
      ends.forEach(function (btn, i) { btn.addEventListener("click", function () { touch(); glide(i, 420); }); });

      // On a picture: drag sideways to grow or shrink the dots, tap to flip between the two images.
      Array.prototype.slice.call(root.querySelectorAll(".gg-pair")).forEach(function (pair) {
        var down = null;
        pair.addEventListener("pointerdown", function (e) {
          if (e.button) return;
          down = { x: e.clientX, y: e.clientY, p: p, moved: false };
          try { pair.setPointerCapture(e.pointerId); } catch (err) {}
        });
        pair.addEventListener("pointermove", function (e) {
          if (!down) return;
          var dx = e.clientX - down.x;
          if (!down.moved && Math.abs(dx) < 5) return;
          if (!down.moved) { down.moved = true; touch(); }
          apply(down.p + dx / Math.max(120, pair.clientWidth));
        });
        pair.addEventListener("pointerup", function (e) {
          if (down && !down.moved && Math.abs(e.clientY - down.y) < 8) { touch(); glide(p < 0.5 ? 1 : 0, 520); }
          down = null;
        });
        ["pointercancel", "lostpointercapture"].forEach(function (name) {
          pair.addEventListener(name, function () { down = null; });
        });
      });

      // The dots grow in once on load (the title shows it), and once more when the pictures first come into view.
      root.classList.add("gg-js");
      if (reduce) { apply(0.5); }
      else {
        var born = Date.now();
        apply(0); glide(0.5, 1400);
        handle.classList.add("hint");
        if ("IntersectionObserver" in window) {
          var seen = new IntersectionObserver(function (entries) {
            if (!entries[0].isIntersecting) return;
            seen.disconnect();
            if (!touched && Date.now() - born > 1600) { apply(0); glide(0.5, 1400); }
          }, { threshold: 0.2 });
          seen.observe(root.querySelector(".gg-plates") || track);
        }
      }
    }

    /* ---------- the schedule: a marker walks the two phases ---------- */
    var sched = root.querySelector(".gg-sched");
    if (sched && !reduce && "IntersectionObserver" in window) {
      var dot = sched.querySelector(".gg-s-dot"), svg = sched.querySelector(".gg-s-loop svg");
      var marks = Array.prototype.slice.call(sched.querySelectorAll(".gg-s-run i"));
      var items = {};
      Array.prototype.slice.call(root.querySelectorAll("[data-step]")).forEach(function (n) { items[n.getAttribute("data-step")] = n; });
      var ORBITS = 3, T_ORBIT = 1.7, T_HOP = 0.8, T_STAY = 0.7, T_END = 1.6;
      var total = ORBITS * T_ORBIT + marks.length * (T_HOP + T_STAY) + T_END;
      var visible = false, running = false, start = null, lastKey = "", lastOn = -1;

      function show(key, on) {
        if (key !== lastKey) {
          if (items[lastKey]) items[lastKey].classList.remove("on");
          if (items[key]) items[key].classList.add("on");
          lastKey = key;
        }
        if (on !== lastOn) { marks.forEach(function (m, i) { m.classList.toggle("on", i < on); }); lastOn = on; }
      }
      function frame(now) {
        if (!visible) { running = false; return; }
        if (start === null) start = now;
        var t = ((now - start) / 1000) % total;
        var sr = sched.getBoundingClientRect(), lr = svg.getBoundingClientRect(), k = lr.width / 130;
        var cx = lr.left - sr.left + 65 * k, cy = lr.top - sr.top + 68 * k, R = 40 * k;
        var x, y, key = "", on = 0;
        if (t < ORBITS * T_ORBIT) {
          var f = (t / T_ORBIT) % 1, a = Math.PI / 2 + f * 2 * Math.PI;
          x = cx + R * Math.cos(a); y = cy + R * Math.sin(a); key = "a" + (1 + Math.floor(f * 3));
        } else {
          t -= ORBITS * T_ORBIT;
          var base = cy + R, i = Math.floor(t / (T_HOP + T_STAY));
          function at(j) { if (j < 0) return cx; var r = marks[j].getBoundingClientRect(); return r.left - sr.left + r.width / 2; }
          if (i >= marks.length) { x = at(marks.length - 1); y = base; on = marks.length; }
          else {
            var u = t - i * (T_HOP + T_STAY), x0 = at(i - 1), x1 = at(i);
            if (u < T_HOP) { var e = ease(u / T_HOP); x = x0 + (x1 - x0) * e; y = base - Math.sin(Math.PI * e) * Math.min(26, (x1 - x0) * 0.45); key = "b1"; on = i; }
            else { x = x1; y = base; key = (u - T_HOP) / T_STAY < 0.6 ? "b2" : "b3"; on = i + 1; }
          }
        }
        dot.style.transform = "translate(" + x.toFixed(1) + "px," + y.toFixed(1) + "px)";
        if (!dot.style.opacity) dot.style.opacity = "1";
        show(key, on);
        raf(frame);
      }
      sched.classList.add("live");
      new IntersectionObserver(function (entries) {
        visible = entries[0].isIntersecting;
        if (visible && !running) { running = true; raf(frame); }
      }, { threshold: 0.1 }).observe(sched);
    }

    /* ---------- copy BibTeX ---------- */
    var copy = root.querySelector(".gg-bib button");
    if (copy) {
      copy.hidden = false;
      copy.addEventListener("click", function () {
        var text = root.querySelector(".gg-bib pre").textContent;
        function done() { copy.textContent = "Copied"; setTimeout(function () { copy.textContent = "Copy"; }, 1600); }
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, function () {});
      });
    }
  })();
</script>
