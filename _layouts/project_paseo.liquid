---
layout: default
---
<!-- _layouts/project_paseo.liquid: dark "darkroom" project page, matching the PASEO poster -->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
  /* The whole page is dark in both site themes, so the navbar and footer follow. */
  :root, html[data-theme="light"], html[data-theme="dark"] {
    --global-bg-color: #0A0B0E;
    --global-text-color: #ECEAE4;
    --global-text-color-light: #8D8F96;
    --global-theme-color: #D7FF3E;
    --global-hover-color: #D7FF3E;
    --global-hover-text-color: #0A0B0E;
    --global-divider-color: #3A3C44;
    --global-card-bg-color: #111216;
    --global-code-bg-color: #111216;
    --global-footer-bg-color: #0A0B0E;
    --global-footer-text-color: #8D8F96;
    --global-footer-link-color: #ECEAE4;
    --ps-bg: #0A0B0E; --ps-ink: #ECEAE4; --ps-soft: #C9C8C3; --ps-dim: #8D8F96; --ps-rule: #3A3C44;
    --ps-good: #D7FF3E; --ps-bad: #FF6B5E;
  }
  body { overflow-x: clip; }

  .ps { font-family: "Barlow", "Avenir Next", "Helvetica Neue", sans-serif; color: var(--ps-ink); font-size: 1.06rem; line-height: 1.55; }
  .ps * { box-sizing: border-box; }
  .ps a { color: var(--ps-good); }
  .ps-mono { font-family: "IBM Plex Mono", "SF Mono", Menlo, monospace; letter-spacing: .12em; text-transform: uppercase; }
  .ps-bleed { width: 100vw; margin-left: calc(50% - 50vw); }
  .ps-wide { width: min(1180px, calc(100vw - 2.5rem)); margin-left: 50%; transform: translateX(-50%); }
  .ps i.v { font-family: "Times New Roman", serif; font-style: italic; font-size: 1.08em; }
  .ps .good { color: var(--ps-good); } .ps .bad { color: var(--ps-bad); }

  /* ---------- comparison with a leaning divider ---------- */
  .ps-cmp { position: relative; overflow: hidden; background: #111216; touch-action: pan-y; cursor: ew-resize;
    user-select: none; -webkit-user-select: none; }
  .ps-cmp img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;
    pointer-events: none; -webkit-user-drag: none; }
  .ps-cmp-line { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .ps-cmp-line line { stroke: var(--ps-good); stroke-width: 2; }
  .ps-cmp-knob { z-index: 3; position: absolute; width: 2.6rem; height: 2.6rem; margin: -1.3rem 0 0 -1.3rem; border-radius: 50%;
    background: var(--ps-bg); border: 2px solid var(--ps-good); display: grid; place-items: center; padding: 0;
    cursor: ew-resize; touch-action: none; }
  .ps-cmp-knob svg { width: 1.3rem; height: 1.3rem; fill: var(--ps-good); }
  .ps-cmp-knob:focus-visible { outline: 2px solid var(--ps-ink); outline-offset: 3px; }

  /* ---------- hero ---------- */
  .ps-hero { position: relative; margin-top: -3rem; }
  .ps-hero .ps-cmp { height: min(74vh, 46rem); min-height: 24rem; }
  .ps-hero .ps-cmp img { object-position: 50% 52%; }
  .ps-vig { position: absolute; left: 0; right: 0; top: 0; height: 32%; pointer-events: none;
    background: linear-gradient(to bottom, rgba(10,11,14,.78), rgba(10,11,14,0)); }
  .ps-fade { position: absolute; left: 0; right: 0; bottom: -1px; height: 52%; pointer-events: none;
    background: linear-gradient(to bottom, rgba(10,11,14,0) 0%, rgba(10,11,14,.8) 58%, #0A0B0E 100%); }
  .ps-lab { position: absolute; top: 1.6rem; pointer-events: none; }
  .ps-lab.l { left: clamp(1rem, 4vw, 3.5rem); } .ps-lab.r { right: clamp(1rem, 4vw, 3.5rem); text-align: right; }
  .ps-lab small { display: block; font-size: clamp(.55rem, 1.2vw, .78rem); color: var(--ps-soft); margin-bottom: .35rem; }
  .ps-lab.r small { color: var(--ps-good); }
  .ps-lab strong { display: block; font-family: "Barlow Condensed", sans-serif; font-weight: 800; text-transform: uppercase;
    font-size: clamp(1.5rem, 5vw, 3.6rem); line-height: .9; letter-spacing: .01em; }
  .ps-labs { position: absolute; inset: 0; pointer-events: none; }
  .ps-labs.blur .ps-lab strong { filter: blur(.055em); }
  .ps-lab.r strong { color: var(--ps-good); }
  .ps-name { z-index: 2; position: absolute; left: clamp(.7rem, 3.4vw, 3rem); bottom: .03em; margin: 0; pointer-events: none;
    font-family: "Barlow Condensed", sans-serif; font-weight: 800; text-transform: uppercase; color: var(--ps-ink);
    font-size: clamp(6.4rem, 41vw, 31rem); line-height: .8; letter-spacing: -.015em; }
  .ps-name i { display: inline-block; font-style: normal; transform-origin: 50% 80%; will-change: transform; }
  .ps-name i.o { color: transparent; -webkit-text-stroke: .03em var(--ps-good); }

  /* ---------- title block ---------- */
  .ps-head { padding: clamp(1.6rem, 4vw, 2.6rem) 0 0; }
  .ps-title { font-family: "Barlow Condensed", sans-serif; font-weight: 700; text-transform: uppercase; color: var(--ps-soft);
    font-size: clamp(1.45rem, 3.5vw, 2.5rem); line-height: 1.12; letter-spacing: .02em; margin: 0 0 1.1rem; }
  .ps-title b { color: var(--ps-good); font-weight: 700; }
  .ps-authors { font-size: clamp(.68rem, 1.25vw, .86rem); color: var(--ps-soft); line-height: 1.9; }
  .ps-authors span { white-space: nowrap; }
  .ps-authors span:not(:last-child)::after { content: "·"; margin: 0 .2em 0 .75em; color: var(--ps-dim); }
  .ps-aff { font-size: clamp(.64rem, 1.15vw, .8rem); color: var(--ps-dim); margin-top: .35rem; }
  .ps-links { display: flex; flex-wrap: wrap; gap: .7rem; margin: 1.7rem 0 0; }
  .ps-links a, .ps-links span { font-size: .78rem; padding: .62rem 1.15rem; border: 1px solid var(--ps-good); border-radius: 99px;
    color: var(--ps-good); text-decoration: none; transition: background .15s, color .15s; }
  .ps-links a:hover { background: var(--ps-good); color: var(--ps-bg); text-decoration: none; }
  .ps-links a.fill { background: var(--ps-good); color: var(--ps-bg); }
  .ps-links a.fill:hover { background: var(--ps-ink); border-color: var(--ps-ink); }
  .ps-links span { border-color: var(--ps-rule); color: var(--ps-dim); }

  /* ---------- sections ---------- */
  .ps-sec { margin-top: clamp(3.2rem, 8vw, 5.5rem); }
  .ps-kicker { font-size: .78rem; color: var(--ps-good); border-top: 1px solid var(--ps-rule); padding-top: 1rem; margin: 0 0 1.4rem; }
  .ps-kicker span { color: var(--ps-dim); }
  .ps-lede { font-size: clamp(1.25rem, 2.6vw, 1.7rem); line-height: 1.35; font-weight: 500; margin: 0 0 1rem; max-width: 46rem; }
  .ps-lede b { color: var(--ps-good); font-weight: 600; }
  .ps p.ps-body { color: var(--ps-soft); max-width: 44rem; margin: 0 0 1rem; }

  /* ---------- method ---------- */
  .ps-steps { display: grid; grid-template-columns: 1fr 1fr; column-gap: 3rem; }
  .ps-step { border-top: 1px solid var(--ps-rule); padding: 1.1rem 0 1.9rem; min-width: 0; }
  .ps-step h3 { font-size: .76rem; font-weight: 400; color: var(--ps-good); margin: 0; }
  .ps-step h3 span { color: var(--ps-dim); }
  .ps-step.prob h3 { color: var(--ps-bad); }
  .ps-eq { display: flex; align-items: center; min-height: 5.6rem; margin: .5rem 0 .7rem; }
  .ps-eq img { display: block; height: auto; max-width: 100%; }
  .ps-step p { color: var(--ps-soft); margin: 0; }
  .ps-step p b { color: var(--ps-ink); font-weight: 600; }
  .ps-step p b.good { color: var(--ps-good); } .ps-step p b.bad { color: var(--ps-bad); }
  .ps-final { grid-column: 1 / -1; border: 1.5px solid var(--ps-good); border-radius: .6rem; padding: 1.3rem 1.6rem 1.5rem; min-width: 0; }
  .ps-final .row { display: flex; flex-wrap: wrap; align-items: center; gap: 1.4rem 3rem; margin: 1.3rem 0; }
  .ps-final .row img { display: block; height: auto; max-width: 100%; }
  .ps-final .defs { display: grid; row-gap: .8rem; min-width: 0; }
  .ps-final .leg { font-size: .92rem; color: var(--ps-dim); margin: 0; }

  /* ---------- gallery ---------- */
  .ps-pick { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; margin: 0 0 1.6rem; }
  .ps-pick > span { font-size: .72rem; color: var(--ps-dim); margin-right: .4rem; }
  .ps-pick button { font: inherit; font-family: "IBM Plex Mono", Menlo, monospace; font-size: .72rem; letter-spacing: .12em;
    text-transform: uppercase; padding: .5rem .95rem; border-radius: 99px; border: 1px solid var(--ps-rule);
    background: none; color: var(--ps-soft); cursor: pointer; }
  .ps-pick button:hover { border-color: var(--ps-soft); }
  .ps-pick button[aria-pressed="true"] { border-color: var(--ps-good); color: var(--ps-bg); background: var(--ps-good); }
  .ps-frames { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2.4vw, 2rem); align-items: start; }
  .ps-frame { margin: 0; min-width: 0; }
  .ps-frame:nth-child(2) { margin-top: 3.2rem; }
  .ps-frame .ps-cmp { aspect-ratio: 1 / 1; }
  .ps-frame figcaption { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-top: .7rem; }
  .ps-frame figcaption b { font-family: "Barlow Condensed", sans-serif; font-weight: 800; font-size: 1.9rem; line-height: 1;
    text-transform: uppercase; }
  .ps-frame figcaption span { font-size: .68rem; color: var(--ps-dim); text-align: right; }
  .ps-tag { position: absolute; top: .7rem; font-size: .62rem; padding: .3rem .6rem; border-radius: 99px; pointer-events: none;
    background: rgba(10,11,14,.72); color: var(--ps-ink); }
  .ps-tag.l { left: .7rem; } .ps-tag.r { right: .7rem; color: var(--ps-good); }
  .ps-note { font-size: .86rem; color: var(--ps-dim); margin: 1.3rem 0 0; max-width: 44rem; }

  /* ---------- results ---------- */
  .ps-res { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 2.5rem 4rem; align-items: start; }
  .ps table.ps-table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; margin: 0; color: var(--ps-ink); }
  .ps-table th { font-family: "IBM Plex Mono", Menlo, monospace; font-weight: 400; font-size: .7rem; letter-spacing: .12em;
    text-transform: uppercase; color: var(--ps-dim); text-align: left; padding: 0 0 .6rem; border: 0; background: none; }
  .ps-table td { padding: .72rem 0; border: 0; border-top: 1px solid var(--ps-rule); white-space: nowrap; font-size: 1.12rem; }
  .ps-table td:first-child { color: var(--ps-soft); font-size: 1rem; white-space: normal; }
  .ps-table td b { font-weight: 600; } .ps-table td span { color: var(--ps-dim); font-size: .9rem; margin-left: .45rem; }
  .ps-table td.us b { color: var(--ps-good); } .ps-table td.us span, .ps-table td.them { color: var(--ps-soft); }
  .ps-table tr.mem td { border-top: 2px solid var(--ps-dim); }
  .ps-stats { display: grid; row-gap: 1.6rem; }
  .ps-stat .n { font-family: "Barlow Condensed", sans-serif; font-weight: 800; font-size: clamp(4rem, 9vw, 6.2rem); line-height: .86;
    color: var(--ps-good); }
  .ps-stat:nth-child(3) .n { color: var(--ps-ink); }
  .ps-stat .l { font-size: .72rem; color: var(--ps-dim); margin-top: .5rem; }

  /* ---------- citation ---------- */
  .ps-bib { position: relative; border: 1px solid var(--ps-rule); border-radius: .6rem; background: #111216; }
  .ps-bib pre { margin: 0; padding: 1.3rem 1.4rem; overflow-x: auto; background: none; border: 0; color: var(--ps-soft);
    font-family: "IBM Plex Mono", Menlo, monospace; font-size: .82rem; line-height: 1.6; }
  .ps-bib button { position: absolute; top: .7rem; right: .7rem; font-family: "IBM Plex Mono", Menlo, monospace; font-size: .66rem;
    letter-spacing: .12em; text-transform: uppercase; padding: .4rem .75rem; border-radius: 99px; cursor: pointer;
    border: 1px solid var(--ps-rule); background: var(--ps-bg); color: var(--ps-soft); }
  .ps-bib button:hover { border-color: var(--ps-good); color: var(--ps-good); }
  .ps-end { font-size: .7rem; color: var(--ps-dim); margin: 3.5rem 0 1rem; }

  @media (max-width: 820px) {
    .ps-steps { grid-template-columns: 1fr; }
    .ps-frames { grid-template-columns: 1fr; }
    .ps-frame:nth-child(2) { margin-top: 0; }
    .ps-res { grid-template-columns: 1fr; }
    .ps-stats { grid-template-columns: repeat(3, auto); justify-content: space-between; column-gap: 1rem; }
    .ps-stat .n { font-size: clamp(2.6rem, 13vw, 4.6rem); }
    .ps-eq { min-height: 4.2rem; }
    .ps-final { padding: 1.1rem 1.1rem 1.3rem; }
    .ps-hero .ps-cmp { height: min(68vh, 40rem); }
  }
  @media (max-width: 520px) {
    .ps-stat .l { font-size: .58rem; letter-spacing: .06em; }
    .ps-table td { font-size: 1rem; } .ps-table td:first-child { font-size: .9rem; }
    .ps-table td span { display: block; margin: 0; }
    .ps-bib pre { padding-top: 3rem; font-size: .74rem; }
  }
</style>

<div class="post ps">
  {{ content }}
</div>

<script>
  (function () {
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var all = [];

    document.querySelectorAll(".ps-cmp").forEach(function (el, index) {
      var top = el.querySelector(".ps-cmp-top");
      var line = el.querySelector(".ps-cmp-line line");
      var knob = el.querySelector(".ps-cmp-knob");
      var sideL = el.querySelectorAll(".ps-side-l"), sideR = el.querySelectorAll(".ps-side-r");
      var lean = parseFloat(el.dataset.lean || "0.22");   // horizontal run of the divider, as a fraction of the height
      var knobY = parseFloat(el.dataset.knob || "0.5");
      var state = { pos: 0.5, touched: false, visible: false, t0: null, intro: el.hasAttribute("data-intro") };

      function run() { return lean * el.clientHeight / Math.max(1, el.clientWidth); }
      function draw() {
        var d = run(), a = (state.pos + d / 2) * 100, b = (state.pos - d / 2) * 100;
        var left = "polygon(0 0, " + a + "% 0, " + b + "% 100%, 0 100%)";
        var right = "polygon(" + a + "% 0, 100% 0, 100% 100%, " + b + "% 100%)";
        top.style.clipPath = left;
        sideL.forEach(function (n) { n.style.clipPath = left; });
        sideR.forEach(function (n) { n.style.clipPath = right; });
        line.setAttribute("x1", a + "%"); line.setAttribute("x2", b + "%");
        knob.style.left = (a + (b - a) * knobY) + "%"; knob.style.top = (knobY * 100) + "%";
        knob.setAttribute("aria-valuenow", Math.round(state.pos * 100));
      }
      // The letters of the name are on springs: the divider knocks them as it sweeps past.
      var name = el.querySelector(".ps-name"), letters = [], lastMove = 0;
      if (name && !reduce) name.querySelectorAll("i").forEach(function (node, i) {
        letters.push({ node: node, x: 0, vx: 0, y: 0, vy: 0, r: 0, vr: 0, k: 1 + 0.22 * Math.sin(i * 2.4) });
      });
      function knock(dx, now) {
        var dt = Math.min(0.1, Math.max(0.008, (now - lastMove) / 1000)); lastMove = now;
        var speed = Math.max(0.1, Math.min(1, Math.abs(dx / dt) / 700));   // slow drift barely moves them
        var w = el.clientWidth, h = el.clientHeight, d = run();
        letters.forEach(function (L) {
          var lw = L.node.offsetWidth || 1;
          var cx = name.offsetLeft + L.node.offsetLeft + lw / 2;
          var cy = (name.offsetTop + L.node.offsetTop + L.node.offsetHeight / 2) / h;
          var gap = (cx - (state.pos + d * (0.5 - cy)) * w) / (0.55 * lw);
          var near = Math.exp(-gap * gap) * speed;
          L.vx += dx * near * 2.0; L.vr += dx * near * 110 / lw; L.vy -= Math.abs(dx) * near * 0.8;
        });
      }
      state.spring = function (dt) {
        letters.forEach(function (L) {
          L.vx += (-150 * L.k * L.x - 7.5 * L.vx) * dt; L.x += L.vx * dt;
          L.vy += (-210 * L.k * L.y - 10 * L.vy) * dt; L.y += L.vy * dt;
          L.vr += (-85 * L.k * L.r - 4.6 * L.vr) * dt; L.r += L.vr * dt;
          var still = Math.abs(L.x) + Math.abs(L.y) + Math.abs(L.r) + Math.abs(L.vx) / 60 + Math.abs(L.vr) / 60 < 0.02;
          L.node.style.transform = still ? "" :
            "translate(" + L.x.toFixed(2) + "px," + L.y.toFixed(2) + "px) rotate(" + L.r.toFixed(2) + "deg)";
        });
      };
      function set(p) {
        var before = state.pos;
        state.pos = Math.min(1, Math.max(0, p)); draw();
        if (letters.length && state.ready) knock((state.pos - before) * el.clientWidth, performance.now());
      }
      function follow(e) {
        var r = el.getBoundingClientRect();
        var y = (e.clientY - r.top) / r.height;
        set((e.clientX - r.left) / r.width - run() * (0.5 - y));   // keep the divider under the pointer
      }

      var dragging = false;
      el.addEventListener("pointerdown", function (e) {
        dragging = true; state.touched = true;
        try { el.setPointerCapture(e.pointerId); } catch (err) {}
        follow(e);
      });
      el.addEventListener("pointermove", function (e) { if (dragging) follow(e); });
      ["pointerup", "pointercancel", "lostpointercapture"].forEach(function (name) {
        el.addEventListener(name, function () { dragging = false; });
      });
      knob.addEventListener("keydown", function (e) {
        var step = e.key === "ArrowLeft" ? -0.04 : e.key === "ArrowRight" ? 0.04 : 0;
        if (step) { state.touched = true; set(state.pos + step); e.preventDefault(); }
      });
      window.addEventListener("resize", draw);

      // Until someone touches it, the divider develops in once and then drifts slowly.
      state.tick = function (now) {
        if (state.touched || !state.visible || reduce) return;
        if (state.t0 === null) state.t0 = now;
        var t = (now - state.t0) / 1000, base = 0.5;
        if (state.intro && t < 1.6) { var k = 1 - Math.pow(1 - t / 1.6, 3); base = 0.94 - 0.44 * k; }
        var drift = 0.045 * Math.sin((t - (state.intro ? 1.6 : 0)) * 0.9 + index * 1.7);
        set(base + (state.intro && t < 1.6 ? 0 : drift));
      };
      if ("IntersectionObserver" in window) {
        new IntersectionObserver(function (entries) { state.visible = entries[0].isIntersecting; }, { threshold: 0.15 }).observe(el);
      } else { state.visible = true; }

      set(reduce || !state.intro ? 0.5 : 0.94);
      state.ready = true;
      all.push(state);
    });

    var lastFrame = null;
    function loop(now) {
      var dt = lastFrame === null ? 0.016 : Math.min(0.033, (now - lastFrame) / 1000); lastFrame = now;
      all.forEach(function (s) { s.tick(now); if (s.spring) s.spring(dt); });
      window.requestAnimationFrame(loop);
    }
    if (!reduce) window.requestAnimationFrame(loop);

    // Gallery: choose what PASEO is compared against.
    var names = { y: "Measurement", silo: "SILO", x: "Reference" };
    var picks = document.querySelectorAll(".ps-pick.ps-src button");
    picks.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var key = btn.dataset.src;
        picks.forEach(function (b) { b.setAttribute("aria-pressed", b === btn ? "true" : "false"); });
        document.querySelectorAll(".ps-frame").forEach(function (frame) {
          var img = frame.querySelector(".ps-cmp-top");
          img.src = img.dataset.base + key + ".jpg";
          img.alt = names[key] + ", " + frame.dataset.task;
          frame.querySelector(".ps-tag.l").textContent = names[key];
        });
      });
    });

    var copy = document.querySelector(".ps-bib button");
    if (copy) copy.addEventListener("click", function () {
      var text = document.querySelector(".ps-bib pre").textContent;
      if (navigator.clipboard) navigator.clipboard.writeText(text).then(function () {
        copy.textContent = "Copied"; setTimeout(function () { copy.textContent = "Copy"; }, 1600);
      });
    });
  })();
</script>
